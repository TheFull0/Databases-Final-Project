<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-items: center; justify-content: center; margin-top: 450px; margin-bottom: 450px;">
            <ui:TextField label="Name:" placeholder-text="Player" name="ChoseNameTF" style="font-size: 60px; flex-grow: 0; width: 800px;"/>
            <ui:VisualElement style="flex-grow: 1; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-content: auto; align-items: auto; align-self: stretch;">
                <ui:Button text="Random" name="RandomBTN" style="font-size: 60px;"/>
                <ui:Button text="Submit&#10;" name="SubmitBTN" style="font-size: 60px; flex-grow: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
